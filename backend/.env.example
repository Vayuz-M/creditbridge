# CreditBridge Backend Environment Configuration Template
PROJECT_NAME="CreditBridge"
PROJECT_TAGLINE="Bridging the Credit Gap with Alternative Financial Intelligence"
ENVIRONMENT="production"

# Security (Generate a 32+ character random secret for production)
JWT_SECRET="replace-with-secure-32-char-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Database Configuration
# SQLite: sqlite:///data/creditbridge.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/creditbridge
DATABASE_URL="sqlite:///data/creditbridge.db"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://creditbridge.ai"

# Observability & Docs
ENABLE_DOCS="true"
